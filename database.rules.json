{
  "rules": {
    "liveLocations": {
      ".read": "auth.uid != null",
      ".write": "auth.uid != null",
      "$key": {
        ".validate": "newData.hasChildren(['latitude', 'longitude'])"
      }
    },
    "trips": {
      ".read": "auth.uid != null",
      ".write": "auth.uid != null",
      "$tripId": {
        ".validate": "newData.hasChildren(['busId', 'startLocation'])"
      }
    }
  }
}