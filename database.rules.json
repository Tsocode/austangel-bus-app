{
  "rules": {
    "liveLocations": {
      "$busId": {
        ".read": "auth != null && (auth.token.role === 'admin' || root.child('userBusAccess').child(auth.uid).child($busId).val() === true)",
        ".write": "auth != null && (auth.token.role === 'admin' || root.child('busAssignments').child($busId).child('driverId').val() === auth.uid)",
        ".validate": "newData.hasChildren(['latitude', 'longitude', 'updatedAt']) && newData.child('latitude').isNumber() && newData.child('latitude').val() >= -90 && newData.child('latitude').val() <= 90 && newData.child('longitude').isNumber() && newData.child('longitude').val() >= -180 && newData.child('longitude').val() <= 180 && newData.child('updatedAt').isNumber()",
        "latitude": { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
        "longitude": { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
        "updatedAt": { ".validate": "newData.isNumber()" },
        "speed": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "heading": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 360" },
        "accuracy": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "$other": { ".validate": false }
      }
    },
    "busAssignments": {
      ".read": false,
      ".write": false
    },
    "userBusAccess": {
      ".read": false,
      ".write": false
    },
    "trips": {
      ".read": "auth != null && auth.token.role === 'admin'",
      ".write": "auth != null && auth.token.role === 'admin'"
    },
    "activeTravelTrips": {
      "$userId": {
        ".read": "auth != null && auth.uid === $userId",
        ".write": "auth != null && auth.uid === $userId",
        ".validate": "newData.hasChildren(['tripId', 'active', 'latitude', 'longitude', 'timestamp']) || (newData.hasChild('sos') && newData.child('sos').hasChildren(['active', 'timestamp']))",
        "tripId": { ".validate": "newData.isString()" },
        "userId": { ".validate": "newData.isString() && newData.val() === auth.uid" },
        "active": { ".validate": "newData.isBoolean()" },
        "latitude": { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
        "longitude": { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
        "speed": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "heading": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 360" },
        "accuracy": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "timestamp": { ".validate": "newData.isNumber()" },
        "stoppedAt": { ".validate": "newData.isNumber()" },
        "destination": {
          ".validate": "newData.hasChildren(['latitude', 'longitude', 'address'])",
          "latitude": { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
          "longitude": { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
          "address": { ".validate": "newData.isString()" },
          "$other": { ".validate": false }
        },
        "sos": {
          ".validate": "newData.hasChildren(['active', 'timestamp'])",
          "active": { ".validate": "newData.isBoolean()" },
          "timestamp": { ".validate": "newData.isNumber()" },
          "latitude": { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
          "longitude": { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
          "$other": { ".validate": false }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
