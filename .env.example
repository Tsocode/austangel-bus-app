EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-app-id

# Restrict each native Maps SDK key to its matching application and SDK in Google Cloud.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=your-android-maps-sdk-key
EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY=your-ios-maps-sdk-key
# Restrict this key to Maps Embed API and your web app's HTTP referrers.
EXPO_PUBLIC_GOOGLE_MAPS_WEB_API_KEY=your-web-maps-embed-key
# Separate key with Places API (New) enabled; never use the app-restricted native SDK keys here.
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=your-google-places-api-key
# Optional alternative for autocomplete and geocoding REST requests.
EXPO_PUBLIC_MAPBOX_TOKEN=your-mapbox-access-token
