().travelRole is string && profile().travelRole == value;\n    }\n    function profileServiceIs(value) {\n      return profileHas('primaryService') && profile().primaryService is string &&\n        profile().primaryService == value;\n    }\n    function roleIs(value) { return profileRoleIs(value); }\n    // Admin authorization comes from a server-issued Firebase custom claim.\n    // The profile role is display data and is never sufficient by itself.\n    function isAdmin() {\n      return signedIn() && request.auth.token.role == 'admin';\n    }\n    function isSchoolDriver() {\n      return hasProfile() &&\n        ((profileHas('schoolRole') && profile().schoolRole is string && profile().schoolRole == 'driver') ||\n         profileRoleIs('driver')) &&\n        (!profileHas('primaryService') || profile().primaryService != 'travel');\n    }\n    function isSchoolAttendant() { return roleIs('attendant'); }\n    function isSchoolParent() { return roleIs('parent'); }\n    function isTravelPassenger() {\n      // Service switching alone must not turn a driver or school user into a passenger.\n      return hasProfile() &&\n        (profileTravelRoleIs('passenger') ||\n         (profileRoleIs('passenger') && profileServiceIs('travel')));\n    }\n    function isTravelDriver() {\n      return hasProfile() && (profileTravelRoleIs('driver') ||\n        (profileRoleIs('driver') && profileServiceIs('travel')));\n    }\n    function isVerifiedTravelDriver() {\n      return isTravelDriver() && profileHas('verificationStatus') &&\n        profile().verificationStatus == 'verified' &&\n        exists(/databases/$(database)/documents/drivers/$(request.auth.uid)) &&\n        get(/databases/$(database)/documents/drivers/$(request.auth.uid)).data.verificationStatus == 'verified';\n    }\n    function isString(value, max) { return value is string && value.size() <= max; }\n    function optionalString(data, field, max) {\n      return !(field in data) || data[field] == null || isString(data[field], max);\n    }\n    function validUser(data, uid) {\n      return data.keys().hasOnly([\n          'id','email','role','primaryService','schoolRole','travelRole','firstName',\n          'lastName','displayName','phoneNumber','photoURL','assignedBusId','childIds',\n          'fleetId','travelGroupIds','verificationStatus','licenseNumber','createdAt','updatedAt'\n        ]) && data.keys().hasAll(['id','email','role','primaryService','displayName','createdAt']) &&\n        data.id == uid && isString(data.email, 320) && isString(data.displayName, 120) &&\n        data.role in ['parent','driver','attendant','admin','passenger'] &&\n        data.primaryService in ['school','travel'] &&\n        (!('schoolRole' in data) || data.schoolRole == null || data.schoolRole in ['parent','driver','attendant','admin']) &&\n        (!('travelRole' in data) || data.travelRole == null || data.travelRole in ['passenger','driver']) &&\n        optionalString(data,'schoolRole',30) && optionalString(data,'travelRole',30) &&\n        optionalString(data,'firstName',80) && optionalString(data,'lastName',80) &&\n        optionalString(data,'phoneNumber',40) && optionalString(data,'photoURL',2048) &&\n        optionalString(data,'assignedBusId',128) && optionalString(data,'fleetId',128) &&\n        optionalString(data,'licenseNumber',128) && data.childIds is list && data.childIds.size() <= 100 &&\n        data.travelGroupIds is list && data.travelGroupIds.size() <= 100 &&\n        data.createdAt is number && data.createdAt > 0 && data.updatedAt is number;\n    }\n    function validBus(data) {\n      return data.keys().hasOnly(['nickname','plateNumber','driverId','assignedAttendants','driverName','routeId','parentIds','updatedAt']) &&\n        data.keys().hasAll(['nickname']) && isString(data.nickname,100) &&\n        optionalString(data,'plateNumber',32) && optionalString(data,'driverId',128) &&\n        optionalString(data,'driverName',120) && optionalString(data,'routeId',128) &&\n        (!('assignedAttendants' in data) || (data.assignedAttendants is list && data.assignedAttendants.size() <= 100)) &&\n        (!('parentIds' in data) || (data.parentIds is list && data.parentIds.size() <= 200)) &&\n        (!('updatedAt' in data) || data.updatedAt is number);\n    }\n    function validStop(stop) {\n      return stop is map && stop.keys().hasOnly(['id','name','latitude','longitude','order']) &&\n        stop.keys().hasAll(['id','name','latitude','longitude','order']) &&\n        isString(stop.id,128) && isString(stop.name,120) &&\n        stop.latitude is number && stop.latitude >= -90 && stop.latitude <= 90 &&\n        stop.longitude is number && stop.longitude >= -180 && stop.longitude <= 180 &&\n        stop.order is number && stop.order >= 0;\n    }\n    function validRoute(data) {\n      return data.keys().hasOnly(['name','stops','parentIds','createdAt','updatedAt']) &&\n        data.keys().hasAll(['name','stops']) && isString(data.name,120) &&\n        // Route writes are admin-only; cap list size here. Stop shape is also\n        // defined by RouteStop in models/route.ts and is checked in the app.\n        data.stops is list && data.stops.size() <= 200 &&\n        (!('parentIds' in data) || (data.parentIds is list && data.parentIds.size() <= 200)) &&\n        (!('createdAt' in data) || data.createdAt is number) &&\n        (!('updatedAt' in data) || data.updatedAt is number);\n    }\n    function ownsTrip(data) { return signedIn() && data.passengerId == request.auth.uid; }\n    function isUnassignedTrip(data) {\n      // The booking callable writes driverId:null; this matches the driver's\n      // availability query, which filters explicitly on driverId == null.\n      return 'driverId' in data && data.driverId == null;\n    }\n    function isAvailableTripRequest(data) {\n      return data.status == 'requested' && data.paymentStatus == 'paid' && isUnassignedTrip(data);\n    }\n    function validLocation(location) {\n      return location