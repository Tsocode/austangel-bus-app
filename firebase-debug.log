[debug] [2026-11-22T17:11:13.873Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/austangels:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    // Assumed data model:\n    // users/{uid}: id, email, role, primaryService, schoolRole, travelRole,\n    //   displayName, firstName, lastName, phoneNumber, photoURL, assignedBusId,\n    //   childIds, fleetId, travelGroupIds, verificationStatus, licenseNumber,\n    //   createdAt, updatedAt.\n    // buses/{busId}: nickname, plateNumber, driverId, assignedAttendants,\n    //   driverName, routeId, parentIds, updatedAt.\n    // routes/{routeId}: name, stops[{id,name,latitude,longitude,order}], parentIds, timestamps.\n    // checkIns/{id}: tripId, childId, parentId, busId, type, recordedBy,\n    //   timestamp, latitude, longitude, note. parentId is the owner UID for\n    //   users/{parentId}/children/{childId}.\n    // trips/{id}: busId, routeId, driverId, date, shift, status, timestamps.\n    // drivers/{uid}: userId, verificationStatus, isAvailable, stats and profile.\n    // drivers_public/{uid}: approved display and availability fields only.\n    // travelTrips/{id}: passengerId, driverId, pickupLocation, dropoffLocation,\n    //   status, requestedTime, schedule, cost, participant and metadata fields.\n    // liveLocations/{driverUid}: userId, latitude, longitude, timestamp, status.\n\n    function signedIn() { return request.auth != null; }\n    function userPath(uid) {\n      return /databases/$(database)/documents/users/$(uid);\n    }\n    function hasProfile() {\n      return signedIn() && exists(userPath(request.auth.uid));\n    }\n    function profile() { return get(userPath(request.auth.uid)).data; }\n    function profileHas(field) {\n      return hasProfile() && profile().keys().hasAny([field]);\n    }\n    function profileRoleIs(value) {\n      return profileHas('role') && profile().role is string && profile().role == value;\n    }\n    function profileTravelRoleIs(value) {\n      return profileHas('travelRole') && profile().travelRole is string && profile().travelRole == value;\n    }\n    function profileServiceIs(value) {\n      return profileHas('primaryService') && profile().primaryService is string &&\n        profile().primaryService == value;\n    }\n    function roleIs(value) { return profileRoleIs(value); }\n    // Admin authorization comes from a server-issued Firebase custom claim.\n    // The profile role is display data and is never sufficient by itself.\n    function isAdmin() {\n      return signedIn() && request.auth.token.role == 'admin';\n    }\n    function isSchoolDriver() {\n      return hasProfile() &&\n        ((profileHas('schoolRole') && profile().schoolRole is string && profile().schoolRole == 'driver') ||\n         profileRoleIs('driver')) &&\n        (!profileHas('primaryService') || profile().primaryService != 'travel');\n    }\n    function isSchoolAttendant() { return roleIs('attendant'); }\n    function isSchoolParent() { return roleIs('parent'); }\n    function isTravelPassenger() {\n      // Service switching alone must not turn a driver or school user into a passenger.\n      return hasProfile() &&\n        (profileTravelRoleIs('passenger') ||\n         (profileRoleIs('passenger') && profileServiceIs('travel')));\n    }\n    function isTravelDriver() {\n      return hasProfile() && (profileTravelRoleIs('driver') ||\n        (profileRoleIs('driver') && profileServiceIs('travel')));\n    }\n    function isVerifiedTravelDriver() {\n      return isTravelDriver() && profileHas('verificationStatus') &&\n        profile().verificationStatus == 'verified' &&\n        exists(/databases/$(database)/documents/drivers/$(request.auth.uid)) &&\n        get(/databases/$(database)/documents/drivers/$(request.auth.uid)).data.verificationStatus == 'verified';\n    }\n    function isString(value, max) { return value is string && value.size() <= max; }\n    function optionalString(data, field, max) {\n      return !(field in data) || data[field] == null || isString(data[field], max);\n    }\n    function validUser(data, uid) {\n      return data.keys().hasOnly([\n          'id','email','role','primaryService','schoolRole','travelRole','firstName',\n          'lastName','displayName','phoneNumber','photoURL','assignedBusId','childIds',\n          'fleetId','travelGroupIds','verificationStatus','licenseNumber','createdAt','updatedAt'\n        ]) && data.keys().hasAll(['id','email','role','primaryService','displayName','createdAt']) &&\n        data.id == uid && isString(data.email, 320) && isString(data.displayName, 120) &&\n        data.role in ['parent','driver','attendant','admin','passenger'] &&\n        data.primaryService in ['school','travel'] &&\n        (!('schoolRole' in data) || data.schoolRole == null || data.schoolRole in ['parent','driver','attendant','admin']) &&\n        (!('travelRole' in data) || data.travelRole == null || data.travelRole in ['passenger','driver']) &&\n        optionalString(data,'schoolRole',30) && optionalString(data,'travelRole',30) &&\n        optionalString(data,'firstName',80) && optionalString(data,'lastName',80) &&\n        optionalString(data,'phoneNumber',40) && optionalString(data,'photoURL',2048) &&\n        optionalString(data,'assignedBusId',128) && optionalString(data,'fleetId',128) &&\n        optionalString(data,'licenseNumber',128) && data.childIds is list && data.childIds.size() <= 100 &&\n        data.travelGroupIds is list && data.travelGroupIds.size() <= 100 &&\n        data.createdAt is number && data.createdAt > 0 && data.updatedAt is number;\n    }\n    function validBus(data) {\n      return data.keys().hasOnly(['nickname','plateNumber','driverId','assignedAttendants','driverName','routeId','parentIds','updatedAt']) &&\n        data.keys().hasAll(['nickname']) && isString(data.nickname,100) &&\n        optionalString(data,'plateNumber',32) && optionalString(data,'driverId',128) &&\n        optionalString(data,'driverName',120) && optionalString(data,'routeId',128) &&\n        (!('assignedAttendants' in data) || (data.assignedAttendants is list && data.assignedAttendants.size() <= 100)) &&\n        (!('parentIds' in data) || (data.parentIds is list && data.parentIds.size() <= 200)) &&\n        (!('updatedAt' in data) || data.updatedAt is number);\n    }\n    function validStop(stop) {\n      return stop is map && stop.keys().hasOnly(['id','name','latitude','longitude','order']) &&\n        stop.keys().hasAll(['id','name','latitude','longitude','order']) &&\n        isString(stop.id,128) && isString(stop.name,120) &&\n        stop.latitude is number && stop.latitude >= -90 && stop.latitude <= 90 &&\n        stop.longitude is number && stop.longitude >= -180 && stop.longitude <= 180 &&\n        stop.order is number && stop.order >= 0;\n    }\n    function validRoute(data) {\n      return data.keys().hasOnly(['name','stops','parentIds','createdAt','updatedAt']) &&\n        data.keys().hasAll(['name','stops']) && isString(data.name,120) &&\n        // Route writes are admin-only; cap list size here. Stop shape is also\n        // defined by RouteStop in models/route.ts and is checked in the app.\n        data.stops is list && data.stops.size() <= 200 &&\n        (!('parentIds' in data) || (data.parentIds is list && data.parentIds.size() <= 200)) &&\n        (!('createdAt' in data) || data.createdAt is number) &&\n        (!('updatedAt' in data) || data.updatedAt is number);\n    }\n    function ownsTrip(data) { return signedIn() && data.passengerId == request.auth.uid; }\n    function isUnassignedTrip(data) {\n      // The booking callable writes driverId:null; this matches the driver's\n      // availability query, which filters explicitly on driverId == null.\n      return 'driverId' in data && data.driverId == null;\n    }\n    function isAvailableTripRequest(data) {\n      return data.status == 'requested' && data.paymentStatus == 'paid' && isUnassignedTrip(data);\n    }\n    function validLocation(location) {\n      return location is map && location.keys().hasOnly(['latitude','longitude','address','name']) &&\n        location.keys().hasAll(['latitude','longitude','address']) &&\n        location.latitude is number && location.latitude >= -90 && location.latitude <= 90 &&\n        location.longitude is number && location.longitude >= -180 && location.longitude <= 180 &&\n        isString(location.address,300) && optionalString(location,'name',120);\n    }\n    function validTravelTrip(data) {\n      return data.keys().hasOnly([\n          'tripType','passengerId','driverId','travelGroupId','vehicleId',\n          'pickupLocation','dropoffLocation','requestedTime','scheduledTime','startTime','endTime',\n          'estimatedDuration','status','passengers','specialRequests','estimatedCost','finalCost',\n          'createdAt','updatedAt','cancellationReason','paymentStatus','serviceClass',\n          'estimatedCostCents','estimatedDistanceKm','currency','paymentIntentId','paidAt','refundId'\n        ]) && data.keys().hasAll([\n          'tripType','passengerId','pickupLocation','dropoffLocation','requestedTime',\n          'status','createdAt','updatedAt'\n        ]) && data.tripType in ['airport','chauffeur','tourism','corporate','wedding','other'] &&\n        isString(data.passengerId,128) && validLocation(data.pickupLocation) &&\n        validLocation(data.dropoffLocation) && data.requestedTime is number &&\n        data.status in ['requested','assigned','accepted','in_progress','completed','cancelled'] &&\n        data.createdAt is number && data.updatedAt is number &&\n        (!('driverId' in data) || isString(data.driverId,128)) &&\n        (!('travelGroupId' in data) || isString(data.travelGroupId,128)) &&\n        (!('vehicleId' in data) || isString(data.vehicleId,128)) &&\n        (!('scheduledTime' in data) || data.scheduledTime is number) &&\n        (!('startTime' in data) || data.startTime is number) &&\n        (!('endTime' in data) || data.endTime is number) &&\n        (!('estimatedDuration' in data) || (data.estimatedDuration is number && data.estimatedDuration >= 0)) &&\n        (!('passengers' in data) || (data.passengers is int && data.passengers >= 1 && data.passengers <= 100)) &&\n        optionalString(data,'specialRequests',1000) && optionalString(data,'cancellationReason',500) &&\n        (!('estimatedCost' in data) || (data.estimatedCost is number && data.estimatedCost >= 0)) &&\n        (!('finalCost' in data) || (data.finalCost is number && data.finalCost >= 0)) &&\n        (!('paymentStatus' in data) || data.paymentStatus in ['unpaid','paid','failed','refund_pending','refunded']) &&\n        (!('serviceClass' in data) || data.serviceClass in ['standard','comfort','premium']) &&\n        (!('estimatedCostCents' in data) ||\n          (data.estimatedCostCents is int && data.estimatedCostCents >= 1 && data.estimatedCostCents <= 100000000)) &&\n        (!('estimatedDistanceKm' in data) ||\n          (data.estimatedDistanceKm is number && data.estimatedDistanceKm >= 0 && data.estimatedDistanceKm <= 100000)) &&\n        (!('currency' in data) || (isString(data.currency,3) && data.currency.matches('^[a-z]{3}$'))) &&\n        optionalString(data,'paymentIntentId',255) && optionalString(data,'refundId',128) &&\n        (!('paidAt' in data) || data.paidAt is number);\n    }\n    function busAssignedToMe(busId) {\n      return hasProfile() && busId is string &&\n        exists(/databases/$(database)/documents/buses/$(busId)) &&\n        ((profileHas('assignedBusId') && profile().assignedBusId == busId) ||\n         (isSchoolDriver() && get(/databases/$(database)/documents/buses/$(busId)).data.driverId == request.auth.uid) ||\n         (isSchoolAttendant() &&\n          get(/databases/$(database)/documents/buses/$(busId)).data.assignedAttendants is list &&\n          request.auth.uid in get(/databases/$(database)/documents/buses/$(busId)).data.assignedAttendants));\n    }\n    function isAssignedBusStaff(busId) {\n      return signedIn() && busId is string &&\n        exists(/databases/$(database)/documents/buses/$(busId)) &&\n        ((isSchoolDriver() &&\n          get(/databases/$(database)/documents/buses/$(busId)).data.driverId == request.auth.uid) ||\n         (isSchoolAttendant() &&\n          get(/databases/$(database)/documents/buses/$(busId)).data.assignedAttendants is list &&\n          request.auth.uid in get(/databases/$(database)/documents/buses/$(busId)).data.assignedAttendants));\n    }\n    function childBusFieldMatches(child, busId) {\n      return (('defaultBusId' in child) && child.defaultBusId == busId) ||\n        (('assignedBusId' in child) && child.assignedBusId == busId) ||\n        (('busId' in child) && child.busId == busId) ||\n        (('assignedBus' in child) && child.assignedBus == busId);\n    }\n    function staffCanReadChild(child) {\n      return (isSchoolDriver() || isSchoolAttendant()) &&\n        ((('defaultBusId' in child) && isAssignedBusStaff(child.defaultBusId)) ||\n         (('assignedBusId' in child) && isAssignedBusStaff(child.assignedBusId)) ||\n         (('busId' in child) && isAssignedBusStaff(child.busId)) ||\n         (('assignedBus' in child) && isAssignedBusStaff(child.assignedBus)));\n    }\n    function childDocumentPath(parentId, childId) {\n      return /databases/$(database)/documents/users/$(parentId)/children/$(childId);\n    }\n    function checkinChildAndBusMatch(data) {\n      return exists(childDocumentPath(data.parentId, data.childId)) &&\n        get(childDocumentPath(data.parentId, data.childId)).data.guardianIds is list &&\n        data.parentId in get(childDocumentPath(data.parentId, data.childId)).data.guardianIds &&\n        childBusFieldMatches(get(childDocumentPath(data.parentId, data.childId)).data, data.busId) &&\n        exists(/databases/$(database)/documents/bu